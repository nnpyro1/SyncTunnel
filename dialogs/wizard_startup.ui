<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>Wizard_startup</class>
 <widget class="QWizard" name="Wizard_startup">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>833</width>
    <height>597</height>
