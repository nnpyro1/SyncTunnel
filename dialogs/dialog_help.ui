<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>Dialog_help</class>
 <widget class="QDialog" name="Dialog_help">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>400</width>
    <height>300</height>
   </rect>
  </property>
