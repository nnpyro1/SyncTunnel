   </property>
  </widget>
  <action name="actionOpen">
   <property name="text">
    <string>打开</string>
   </property>
   <property name="toolTip">
    <string>打开</string>
   </property>
  </action>
  <action name="actionFolder">
   <property name="checkable">
    <bool>false</bool>
   </property>
   <property name="text">
    <string>在文件管理器中打开</string>
   </property>
  </action>
  <action name="actionupload_file">
   <property name="text">
    <string>同步文件(&amp;U)</string>
   </property>
   <property name="toolTip">
    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;将文件与其他客户端同步&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
   </property>
   <property name="shortcut">
    <string>Ctrl+U</string>
   </property>
  </action>
  <action name="actionHangup">
   <property name="text">
    <string>挂起文件(&amp;H)</string>
   </property>
   <property name="toolTip">
    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;可以把文件挂起到GitHub平台上，因此离线之后其他客户端也可以下载。&lt;/p&gt;&lt;p&gt;要想使用这个功能，你需要先配置GitHub用户名以及PAT。或者使用默认的配置（可能会达到限制）&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; color:#ff0000;&quot;&gt;注意：使用这个功能挂起的文件只能通过“下载挂起的文件”下载，无法通过“从DFHN下载挂起的文件”下载！&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
   </property>
   <property name="shortcut">
    <string>Ctrl+H</string>
   </property>
  </action>
  <action name="actionDownload">
   <property name="text">
    <string>下载挂起的文件(D)</string>
   </property>
   <property name="toolTip">
    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;可以下载挂起到GitHub上的文件。&lt;/p&gt;&lt;p&gt;要想使用这个功能，你需要先配置GitHub用户名以及PAT。或者使用默认的配置（可能会达到限制）&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; color:#ff0000;&quot;&gt;注意：使用这个功能只能下载通过“挂起文件”挂起的文件，无法下载通过“挂起文件到DFHN”挂起的文件！&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
   </property>
   <property name="shortcut">
    <string>Ctrl+Shift+H</string>
   </property>
  </action>
  <action name="actionSync_PAT">
   <property name="text">
    <string>同步PAT</string>
   </property>
   <property name="toolTip">
    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;向已上线的客户端同步设置好的Github PAT&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
   </property>
  </action>
  <action name="actionRefresh">
   <property name="text">
    <string>刷新</string>
   </property>
   <property name="toolTip">
    <string>刷新应用程序</string>
   </property>
   <property name="shortcut">
    <string>F5</string>
   </property>
  </action>
  <action name="actionShutdown_current">
   <property name="text">
    <string>关闭选中的设备</string>
   </property>
   <property name="toolTip">
    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;向选中的设备发送关机请求，使其远程关机&lt;/p&gt;&lt;p&gt;&lt;br/&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:600; color:#ff0000;&quot;&gt;注意：关机后无法远程重新开机，需手动开机&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
   </property>
  </action>
  <action name="actionShutdown">
   <property name="text">
    <string>关机</string>
   </property>
   <property name="toolTip">
    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;取消关机保护并关机。&lt;/p&gt;&lt;p&gt;注意：如果直接关机，会有关机保护阻止关机&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
   </property>
  </action>
  <action name="actionTest_RTT">
   <property name="text">
    <string>测试所有联接的RTT和延迟</string>
   </property>
   <property name="toolTip">
    <string>测试所有联接了的客户端相对于本机的RTT和延迟</string>
   </property>
  </action>
  <action name="actionRequestFile">
   <property name="text">
    <string>向所选客户端请求文件</string>
   </property>
   <property name="toolTip">
    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;请求所选客户端向所有连接设备发送文件&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
   </property>
  </action>
  <action name="actionRemoteCopyFile">
   <property name="text">
    <string>远程复制选中设备上的文件到文件同步目录</string>
   </property>
  </action>
  <action name="actionSend_message">
   <property name="text">
    <string>发送测试消息</string>
   </property>
   <property name="toolTip">
    <string>发送测试消息到选定客户端</string>
   </property>
  </action>
  <action name="actionStart_remote">
   <property name="text">
    <string>开始远程控制选中的设备</string>
   </property>
   <property name="toolTip">
    <string>开始远程控制选中的设备</string>
   </property>
  </action>
  <action name="actionOpen_DriveCrypto">
   <property name="text">
    <string>打开&quot;驱动加密&quot;程序</string>
   </property>
   <property name="toolTip">
    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;驱动加密是由开发本软件的同一个开发者开发的安全数据加密软件，可以将数据安全的加密。&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
   </property>
  </action>
  <action name="actionAdd_file">
   <property name="text">
    <string>添加文件</string>
   </property>
  </action>
  <action name="actionIncremental_sync_enable">
   <property name="text">
    <string>启用可选同步并添加所选文件到可选同步列表</string>
   </property>
   <property name="toolTip">
    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;可选同步功能可以让您只同步您想要的文件，节省网络资源。&lt;/p&gt;&lt;p&gt;点击该按钮，可以将您所选的这个文件添加到可选同步列表以同步这个文件。&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
   </property>
   <property name="shortcut">
    <string>Ctrl+Shift+=</string>
   </property>
  </action>
  <action name="actionIncremental_sync_disable">
   <property name="text">
    <string>将此文件从可选同步列表中移除</string>
   </property>
   <property name="shortcut">
    <string>Ctrl+Shift+-</string>
   </property>
  </action>
  <action name="actionExit_Application">
   <property name="text">
    <string>退出程序 (&amp;E)</string>
   </property>
   <property name="toolTip">
    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;关闭窗口，断开联接，然后退出应用程序。&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
   </property>
  </action>
  <action name="actionHang_up_file_to_dfhn">
   <property name="text">
    <string>挂起文件到DFHN节点</string>
   </property>
   <property name="toolTip">
    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;挂起文件到DFHN节点&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; color:#ff0000;&quot;&gt;注意：使用这个功能挂起的文件只能通过“从DFHN下载挂起的文件”下载，无法通过“下载挂起的文件”下载！&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; color:#000000;&quot;&gt;要了解什么是DFHN，请在“其他-&amp;gt;帮助-&amp;gt;DFHN”界面寻找&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
   </property>
  </action>
  <action name="actionDownload_file_from_dfhn">
   <property name="text">
    <string>从DFHN节点下载已挂起的文件</string>
   </property>
   <property name="toolTip">
    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;从DFHN节点下载已挂起的文件&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; color:#ff0000;&quot;&gt;注意：使用这个功能只能下载通过“挂起文件”挂起的文件，无法下载通过“挂起文件到DFHN”挂起的文件！&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; color:#000000;&quot;&gt;要了解什么是DFHN，请在“其他-&amp;gt;帮助-&amp;gt;DFHN”界面寻找&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
   </property>
  </action>
