   </property>
   <property name="toolTip">
    <string>发送测试消息到选定客户端</string>
   </property>
  </action>
  <action name="actionStart_remote">
   <property name="text">
    <string>开始远程控制选中的设备</string>
   </property>
   <property name="toolTip">
    <string>开始远程控制选中的设备</string>
   </property>
  </action>
  <action name="actionOpen_DriveCrypto">
   <property name="text">
    <string>打开&quot;驱动加密&quot;程序</string>
   </property>
   <property name="toolTip">
    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;驱动加密是由开发本软件的同一个开发者开发的安全数据加密软件，可以将数据安全的加密。&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
   </property>
  </action>
  <action name="actionAdd_file">
   <property name="text">
    <string>添加文件</string>
   </property>
  </action>
  <action name="actionIncremental_sync_enable">
   <property name="text">
    <string>启用可选同步并添加所选文件到可选同步列表</string>
   </property>
   <property name="toolTip">
    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;可选同步功能可以让您只同步您想要的文件，节省网络资源。&lt;/p&gt;&lt;p&gt;点击该按钮，可以将您所选的这个文件添加到可选同步列表以同步这个文件。&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
   </property>
   <property name="shortcut">
    <string>Ctrl+Shift+=</string>
   </property>
  </action>
  <action name="actionIncremental_sync_disable">
   <property name="text">
    <string>将此文件从可选同步列表中移除</string>
   </property>
   <property name="shortcut">
    <string>Ctrl+Shift+-</string>
   </property>
  </action>
  <action name="actionExit_Application">
   <property name="text">
    <string>退出程序 (&amp;E)</string>
   </property>
   <property name="toolTip">
    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;关闭窗口，断开联接，然后退出应用程序。&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
   </property>
  </action>
  <action name="actionHang_up_file_to_dfhn">
   <property name="text">
    <string>挂起文件到DFHN节点</string>
   </property>
   <property name="toolTip">
    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;挂起文件到DFHN节点&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; color:#ff0000;&quot;&gt;注意：使用这个功能挂起的文件只能通过“从DFHN下载挂起的文件”下载，无法通过“下载挂起的文件”下载！&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; color:#000000;&quot;&gt;要了解什么是DFHN，请在“其他-&amp;gt;帮助-&amp;gt;DFHN”界面寻找&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
   </property>
  </action>
  <action name="actionDownload_file_from_dfhn">
   <property name="text">
    <string>从DFHN节点下载已挂起的文件</string>
   </property>
   <property name="toolTip">
    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;从DFHN节点下载已挂起的文件&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; color:#ff0000;&quot;&gt;注意：使用这个功能只能下载通过“挂起文件”挂起的文件，无法下载通过“挂起文件到DFHN”挂起的文件！&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; color:#000000;&quot;&gt;要了解什么是DFHN，请在“其他-&amp;gt;帮助-&amp;gt;DFHN”界面寻找&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
   </property>
  </action>
  <action name="actionRestart_all_applications">
